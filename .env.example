RPC_URL=https://rpc.mainnet.chain.robinhood.com
DB_PATH=data/find.sqlite
DISCOVERY_MS=15000
TRADE_MS=60000
SAMPLE_SIZE=3
INITIAL_LOOKBACK_BLOCKS=300
MAX_LIVE_LAG_BLOCKS=2000
LIVE_OVERLAP_BLOCKS=20
SAMPLE_SLOT_MS=600000
PORT=3000
HOST=127.0.0.1
LOG_CHUNK_BLOCKS=1000
CONFIRMATION_BLOCKS=20
GECKO_REQUESTS_PER_MINUTE=5
STALE_AFTER_MS=180000
RPC_SPACING_MS=1000
RPC_ENRICHMENT=false
AUTO_HUNT_ENABLED=true
# Open beta until $AITER and the lock contract are deployed.
AUTO_HUNT_BETA=true
# AITER_TOKEN_ADDRESS=0x...
# AITER_LOCK_ADDRESS=0x...
# Minimum locked raw token units (for 18 decimals, 1000 tokens = 1000000000000000000000).
AUTO_HUNT_MIN_LOCKED=0
