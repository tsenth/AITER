{
  "name": "find-lab",
  "version": "0.1.0",
  "description": "AITER live Robinhood Chain discovery MVP",
  "scripts": {
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/src/cli.js start",
    "web": "node --env-file-if-exists=.env dist/src/cli.js web",
    "report": "node --env-file-if-exists=.env dist/src/cli.js report",
    "status": "node --env-file-if-exists=.env dist/src/cli.js status",
    "diagnose": "node --env-file-if-exists=.env dist/src/cli.js diagnose",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "private": true,
  "dependencies": {
    "viem": "^2.56.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
